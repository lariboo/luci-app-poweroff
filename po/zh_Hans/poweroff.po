"Language: zh_Hans\n"

msgid "Power Off"
msgstr "关机"

msgid "Power off the device (soft shutdown)"
msgstr "关闭设备电源（软关机）"

msgid "Physical access is required to turn it on again. Press the power button or reconnect the power."
msgstr "再次开机需要物理接触设备，按电源键或重新通电。"

msgid "Perform power off"
msgstr "执行关机"

msgid "Confirm"
msgstr "确认"

msgid "Cancel"
msgstr "取消"

msgid "Are you sure you want to power off the device?"
msgstr "确定要关闭设备电源吗？"

msgid "The device is shutting down"
msgstr "设备正在关机…"

msgid "Please wait for the countdown to finish before unplugging"
msgstr "请等待倒计时结束后再断电"

msgid "Safe to unplug"
msgstr "现在可以断电了"

msgid "Failed to execute power off command."
msgstr "执行关机命令失败。"
